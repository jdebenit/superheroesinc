---
import Layout from "../layouts/Layout.astro"; // Assuming Layout exists
import { Timeline } from "../components/Timeline/Timeline";
import { getCollection } from "astro:content";

const loreEntries = await getCollection("lore", ({ data }) => {
    return (
        data.eventDate !== undefined &&
        (data.showInTimeline === true || data.showInTimeline === undefined)
    );
});

const timelineEntries = await getCollection("timeline");

const charactersEntries = await getCollection("characters");

const allEvents = [
    ...loreEntries.map((entry) => ({
        id: entry.slug,
        title: entry.data.title,
        date: entry.data.eventDate!,
        description: entry.data.description,
        reality: entry.data.reality || "Tierra Zero",
        type: "lore" as const,
        image: entry.data.image,
        slug: entry.slug,
        tags: entry.data.tags,
    })),
    ...timelineEntries.map((entry) => ({
        id: entry.id,
        title: entry.data.title,
        date: entry.data.date,
        description: entry.data.description,
        reality: entry.data.reality || "Tierra Zero",
        type: "timeline" as const,
        image: entry.data.image,
        icon: entry.data.icon,
        displayDate: entry.data.displayDate,
        tags: entry.data.tags,
    })),
    ...charactersEntries.flatMap((entry) => {
        const events = [];
        if (entry.data.birthDate) {
            events.push({
                id: `birth-${entry.slug}`,
                title: `Nacimiento: ${entry.data.name}`,
                date: entry.data.birthDate,
                description: `Nacimiento de ${entry.data.name}${entry.data.alias ? ` (${entry.data.alias})` : ""}.`,
                reality: "Tierra Zero",
                type: "timeline" as const, // Reusing timeline type
                image: entry.data.image,
                icon: "star",
                tags: entry.data.tags,
            });
        }
        if (entry.data.deathDate) {
            events.push({
                id: `death-${entry.slug}`,
                title: `Muerte: ${entry.data.name}`,
                date: entry.data.deathDate,
                description: `Fallecimiento de ${entry.data.name}${entry.data.alias ? ` (${entry.data.alias})` : ""}.`,
                reality: "Tierra Zero",
                type: "timeline" as const,
                image: entry.data.image,
                icon: "skull",
                tags: entry.data.tags,
            });
        }
        return events;
    }),
].sort((a, b) => a.date.getTime() - b.date.getTime());
---

<Layout title="Timeline | SHI">
    <main class="min-h-screen pt-20">
        <div class="content-container">
            <h1 class="text-center mb-4">Timeline</h1>
            <p class="text-center mb-12">
                Explora los eventos de las diferentes esferas.
            </p>

            <Timeline client:only="react" events={allEvents} />
        </div>
    </main>
</Layout>
