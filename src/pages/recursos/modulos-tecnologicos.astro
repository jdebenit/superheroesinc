---
import Layout from "../../layouts/Layout.astro";
import TechModuleList from "../../components/TechModuleList";
---

<Layout title="Lista de Módulos Tecnológicos - Superheroes INC.">
    <section class="modules-page">
        <div class="header">
            <h1 class="page-title">Lista de Módulos Tecnológicos</h1>
            <p class="intro-text">
                Catálogo completo de módulos para tecnoarmaduras, tecnovehículos
                y ciborgs. Incluye mejoras generales y de uso interno. Costes
                revisados por ultima vez el 11/01/2026.
            </p>
            <a href="/recursos" class="back-link">← Volver a Recursos</a>
        </div>

        <div class="modules-container">
            <TechModuleList client:load />
        </div>
    </section>
</Layout>

<style>
    .modules-page {
        padding: 2rem 1rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .header {
        margin-bottom: 3rem;
    }

    .page-title {
        font-size: 3rem;
        color: var(--color-secondary);
        text-shadow: 3px 3px 0px var(--color-primary);
        margin-bottom: 1rem;
        font-family: var(--font-comic, sans-serif);
        text-transform: uppercase;
    }

    .intro-text {
        font-size: 1.2rem;
        max-width: 1200px;
        margin: 0 auto 2rem;
    }

    .back-link {
        display: inline-block;
        color: var(--color-secondary);
        font-weight: bold;
        text-decoration: none;
        border-bottom: 2px solid transparent;
        transition: border-color 0.2s;
    }

    .back-link:hover {
        border-bottom-color: var(--color-secondary);
    }

    .modules-container {
        background: white;
        padding: 2rem;
        border: 4px solid var(--color-secondary);
        box-shadow: 8px 8px 0px var(--color-secondary);
    }

    @media (max-width: 600px) {
        .modules-page {
            padding: 1rem;
        }

        .page-title {
            font-size: 2rem;
        }

        .modules-container {
            padding: 1rem;
        }
    }
</style>
