---
import Layout from "../../layouts/Layout.astro";
import FAQList from "../../components/FAQList";
import { getCollection } from "astro:content";

// Get all FAQ entries
const faqEntries = await getCollection("faq");

// Sort by order field, then alphabetically
const sortedFAQs = faqEntries.sort((a, b) => {
    if (a.data.order !== undefined && b.data.order !== undefined) {
        return a.data.order - b.data.order;
    }
    if (a.data.order !== undefined) return -1;
    if (b.data.order !== undefined) return 1;
    return a.data.question.localeCompare(b.data.question);
});

// Render FAQ content and prepare data for the component
const faqs = await Promise.all(
    sortedFAQs.map(async (entry) => {
        const { Content } = await entry.render();

        // Render to HTML string
        let htmlContent = "";
        try {
            // Create a temporary div to render the content
            const tempDiv = await Content({});
            htmlContent = entry.body; // Use raw markdown for now, will be processed client-side
        } catch (e) {
            htmlContent = entry.body;
        }

        return {
            id: entry.id,
            question: entry.data.question,
            answer: htmlContent,
            tags: entry.data.tags,
            category: entry.data.category,
            order: entry.data.order,
        };
    }),
);
---

<Layout title="Preguntas Frecuentes (FAQs) - Superhéroes INC">
    <section class="faq-page">
        <h1 class="page-title">Preguntas Frecuentes</h1>
        <p class="intro-text">
            Encuentra respuestas a las preguntas más comunes sobre Superhéroes
            INC. Usa la búsqueda o filtra por categorías para encontrar lo que
            necesitas.
        </p>

        <FAQList faqs={faqs} client:load />
    </section>
</Layout>

<style>
    .faq-page {
        padding: 2rem 0;
        max-width: 1000px;
        margin: 0 auto;
    }

    .page-title {
        font-size: 3.5rem;
        margin-bottom: 1rem;
        color: var(--color-secondary);
        text-shadow: 3px 3px 0px var(--color-primary);
    }

    .intro-text {
        font-size: 1.2rem;
        margin-bottom: 3rem;
        line-height: 1.6;
    }

    @media (max-width: 768px) {
        .page-title {
            font-size: 2.5rem;
        }

        .intro-text {
            font-size: 1rem;
        }
    }
</style>
