---
import Layout from "../../layouts/Layout.astro";
import CharacterViewer from "../../components/viewer/CharacterViewer";
import { getCollection } from "astro:content";
import { APP_VERSIONS } from "../../data/appVersions";

const rpgCharacters = await getCollection("rpg");
const webCharacters = rpgCharacters.map((char) => ({
    id: `web_${char.id}`,
    data: char.data,
    addedAt: Date.now(), // Not used for sorting web chars but required by type
    source: "web",
}));
---

<Layout title="Visor de Fichas">
    <section class="viewer-page">
        <div class="header-content">
            <h1 class="page-title">Visor de Fichas ({APP_VERSIONS.CHARACTER_VIEWER})</h1>
            <p class="intro-text">
                Visualiza y consulta fichas de personaje generadas previamente.
                Sube tu archivo JSON o explora las fichas oficiales de la web.
            </p>
        </div>

        <div class="viewer-container">
            <CharacterViewer client:load webCharacters={webCharacters} />
        </div>

        <div class="back-link">
            <a href="/recursos">⬅ Volver a Recursos</a>
        </div>
    </section>
</Layout>

<style>
    .viewer-page {
        padding: 2rem 1rem;
        max-width: 1200px;
        width: 100%;
        box-sizing: border-box;
        margin: 0 auto;
        min-height: 80vh;
    }

    .header-content {
        text-align: center;
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: var(--color-secondary);
        text-shadow: 2px 2px 0px var(--color-primary);
    }

    .intro-text {
        font-size: 1.2rem;
        color: var(--color-text);
        max-width: 600px;
        margin: 0 auto;
    }

    .viewer-container {
        margin-bottom: 3rem;
    }

    .back-link {
        text-align: center;
        margin-top: 2rem;
    }

    .back-link a {
        color: var(--color-secondary);
        font-weight: bold;
        text-decoration: none;
        font-size: 1.1rem;
    }

    .back-link a:hover {
        text-decoration: underline;
        color: var(--color-primary);
    }
</style>
