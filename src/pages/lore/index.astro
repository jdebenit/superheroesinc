---
import Layout from "../../layouts/Layout.astro";

const categories = [
  {
    id: "localizaciones",
    title: "Localizaciones",
    description: "Lugares emblemáticos del mundo de Superheroes INC.",
    image: "/lore/localizaciones.png",
  },
  {
    id: "organizaciones",
    title: "Organizaciones",
    description: "Agencias, corporaciones y sectas que mueven los hilos.",
    image: "/lore/organizaciones.png",
  },
  {
    id: "grupos",
    title: "Grupos",
    description: "Equipos de superhéroes y villanos.",
    image: "/lore/grupos.png",
  },
  {
    id: "eventos",
    title: "Eventos",
    description: "Eventos relevantes en la historia de Superheroes INC.",
    image: "/lore/tecnoguerra.png",
  },
  {
    id: "criaturas",
    title: "Criaturas",
    description: "Criaturas que pueblan el multiverso.",
    image: "/lore/criaturas.png",
  },
  {
    id: "entidades",
    title: "Entidades",
    description: "Entidades que rigen la manifestacion.",
    image: "/lore/entidades.png",
  },
  {
    id: "cronicas",
    title: "Crónicas",
    description:
      "Relatos y crónicas ficticias ambientadas en el universo de Superhéroes INC.",
    image: "/lore/cronicas.png",
  },
  {
    id: "actual-plays",
    title: "Actual plays",
    description: "Narraciones de partidas que influyen en la historia.",
    image: "/lore/actual-plays.png",
  },
];
---

<Layout
  title="Lore y Universo - Juego de Rol Superheroes"
  description="Explora el universo de Superheroes INC: organizaciones, localizaciones, grupos de héroes y villanos, eventos históricos y criaturas del multiverso. Lore completo del juego de rol."
  keywords="lore superheroes inc, universo juego rol superheroes, organizaciones superheroes, grupos superheroes villanos, historia juego rol"
>
  <section class="lore-landing">
    <h1 class="page-title">Archivo de Lore</h1>
    <p class="intro-text">
      Explora la base de datos de Superheroes INC. Aquí encontrarás información
      clasificada sobre el mundo, sus habitantes y las fuerzas que lo gobiernan.
    </p>

    <div class="timeline-cta">
      <a href="/timeline" class="comic-button timeline-button-wrapper">
        <span class="priority-badge">NIVEL OMEGA</span>
        Ver Timeline Completo
      </a>
    </div>

    <div class="categories-grid">
      {
        categories.map((cat) => (
          <a href={`/lore/${cat.id}`} class="category-card">
            <div
              class="card-image"
              style={`background-image: url(${cat.image})`}
            />
            <div class="card-content">
              <h2>{cat.title}</h2>
              <p>{cat.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .lore-landing {
    padding: 2rem 0;
    max-width: 1400px;
    margin: 0 auto;
  }

  .page-title {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    color: var(--color-secondary);
    text-shadow: 3px 3px 0px var(--color-primary);
  }

  .intro-text {
    font-size: 1.2rem;
    max-width: 1400px;
    margin: 0 auto 3rem;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .category-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 4px solid var(--color-secondary);
    background: white;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    overflow: hidden;
  }

  .category-card:hover {
    transform: translateY(-5px);
    box-shadow: 8px 8px 0px var(--color-primary);
  }

  .card-image {
    height: 200px;
    background-size: cover;
    background-position: center;
    border-bottom: 4px solid var(--color-secondary);
  }

  .card-content {
    padding: 1.5rem;
  }

  .card-content h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: var(--color-secondary);
  }

  /* Mobile Responsiveness */
  @media (max-width: 768px) {
    .categories-grid {
      grid-template-columns: 1fr !important;
    }

    .page-title {
      font-size: 2.5rem;
    }

    .intro-text {
      font-size: 1rem;
    }
  }

  .timeline-cta {
    display: flex;
    justify-content: center;
    margin-bottom: 5rem;
    padding: 2rem;
    background-color: rgba(255, 255, 255, 0.5);
    border-top: 2px dashed #d3d0c2;
    border-bottom: 2px dashed #d3d0c2;
  }

  .timeline-button-wrapper {
    position: relative;
    min-width: 250px;
    text-align: center;
  }

  .priority-badge {
    position: absolute;
    top: -12px;
    right: -12px;
    background-color: var(--color-primary);
    color: white;
    font-size: 0.7rem;
    padding: 2px 8px;
    transform: rotate(6deg);
    border: 1px solid var(--color-primary-dark);
    box-shadow: var(--shadow-sm);
    font-weight: bold;
    letter-spacing: 0.05em;
  }

  .timeline-cta .comic-button {
    font-size: 1.5rem;
    padding: 1rem 3rem;
    border-width: 3px;
    background-color: white;
  }

  .timeline-cta .comic-button:hover {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
    transform: translateY(-3px);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.2);
  }
</style>
