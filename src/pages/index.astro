---
import Layout from "../layouts/Layout.astro";
import ComicCard from "../components/ComicCard";
import CharacterCard from "../components/CharacterCard";

import { getCollection } from "astro:content";

// Fetch latest blog posts
const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = sortedPosts.slice(0, 3);

const lastUpdate =
  sortedPosts.length > 0 ? sortedPosts[0].data.pubDate : new Date();
const formattedAuthDate = lastUpdate
  .toLocaleDateString("es-ES", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  })
  .replace(/\./g, "")
  .replace(/ /g, "-")
  .toUpperCase();

const news = latestPosts.map((post) => ({
  title: post.data.title,
  excerpt: post.data.description,
  date: post.data.pubDate.toLocaleDateString("es-ES", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }),
  link: `/blog/${post.slug}`,
}));

// Fetch latest lore updates
const allLore = await getCollection("lore");
const sortedLore = allLore
  .filter((entry) => entry.data.updatedDate) // Only show entries with updatedDate
  .sort((a, b) => {
    const dateA = a.data.updatedDate ? a.data.updatedDate.valueOf() : 0;
    const dateB = b.data.updatedDate ? b.data.updatedDate.valueOf() : 0;
    return dateB - dateA;
  });

const latestLore = sortedLore.slice(0, 3).map((entry) => ({
  title: entry.data.title,
  excerpt: entry.data.description, // Using description as excerpt
  date: entry.data.updatedDate
    ? entry.data.updatedDate.toLocaleDateString("es-ES", {
        day: "numeric",
        month: "short",
        year: "numeric",
      })
    : "",
  link: `/lore/${entry.slug}`,
}));

// Fetch latest character updates
const allCharacters = await getCollection("characters");
const sortedCharacters = allCharacters
  .filter((entry) => entry.data.updatedDate) // Only show entries with updatedDate
  .sort((a, b) => {
    const dateA = a.data.updatedDate ? a.data.updatedDate.valueOf() : 0;
    const dateB = b.data.updatedDate ? b.data.updatedDate.valueOf() : 0;
    return dateB - dateA;
  });

const latestCharacters = sortedCharacters.slice(0, 3).map((entry) => ({
  slug: entry.slug,
  data: {
    name: entry.data.name,
    alias: entry.data.alias,
    description: entry.data.description,
    image: entry.data.image,
    source: entry.data.source,
  },
}));
---

<Layout
  title="Juego de Rol de Superheroes - Superheroes INC. Tercera Edición"
  description="Superheroes INC. es el juego de rol de superhéroes definitivo. Crea tu héroe, vive aventuras épicas y descubre un sistema de rol completo con poderes, organizaciones y un universo único. Manual completo, generador de fichas y recursos para tus partidas."
  keywords="juego rol superheroes, juego de rol de superheroes, juego rol superhéroes, juego de rol superhéroes, superheroes inc, manual juego rol superheroes, sistema rol superheroes, crear personaje superheroe rol, partidas superheroes rol, juego mesa superheroes, rol superhéroes tercera edición"
>
  <section class="hero-container">
    <div
      class="text-center p-8 max-w-4xl mx-auto border-4 border-double border-secondary bg-white shadow-lg transform rotate-1 relative"
    >
      {/* Paper clip visual */}
      <div
        class="absolute -top-6 left-1/2 transform -translate-x-1/2 w-16 h-8 border-t-4 border-l-4 border-r-4 border-gray-400 rounded-t-full"
      >
      </div>

      <div class="mb-6">
        <span
          class="bg-secondary text-white px-4 py-1 text-sm font-mono uppercase tracking-widest"
        >
          DOCUMENTO DE ACCESO RESTRINGIDO
        </span>
      </div>

      <h1
        class="text-6xl md:text-8xl font-bold mb-6 text-secondary border-b-4 border-secondary pb-4 inline-block"
        style="font-family: var(--font-heading); letter-spacing: -0.05em;"
      >
        SUPERHEROES INC.
      </h1>

      <div class="mb-8 relative">
        <p
          class="text-xl md:text-2xl max-w-2xl mx-auto font-mono leading-relaxed"
          style="font-family: var(--font-body);"
        >
          <span class="bg-black text-black select-none mr-2">REDACTED</span>
          La Tercera Edición del juego de rol de superhéroes por antonomasia.
          <span class="bg-black text-black select-none ml-2">DATA</span>
        </p>

        {/* Stamp over text */}
        <div
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 border-4 border-primary text-primary px-8 py-2 text-4xl font-bold uppercase opacity-30 rotate-12 pointer-events-none whitespace-nowrap"
          style="font-family: var(--font-display);"
        >
          DESCLASIFICADO
        </div>
      </div>

      <div class="access-options">
        <div class="access-divider-label">OPCIONES DE ACCESO</div>

        <div class="access-option">
          <a href="/lore" class="comic-button"> ACCEDER AL ARCHIVO </a>
          <span class="access-note">Consulta de datos historicos</span>
        </div>

        <div class="access-option">
          <a
            href="/recursos/generador-fichas"
            class="comic-button recruit-button-wrapper"
          >
            <span class="priority-badge">PRIORIDAD ALPHA</span>
            INICIAR RECLUTAMIENTO
          </a>
          <span class="access-note">Creación de nuevo metahumano</span>
        </div>
      </div>

      <div class="mt-8 text-xs font-mono text-gray-500">
        AUTORIZACIÓN: NIVEL OMEGA // FECHA: {formattedAuthDate}
      </div>
    </div>
  </section>

  <section class="intro-section">
    <div class="intro-content">
      <h2 class="intro-title">El Juego de Rol de Superhéroes Más Completo</h2>
      <div class="intro-text">
        <p>
          <strong>Superheroes INC. Tercera Edición</strong> es un juego de rol de
          superhéroes que te permite crear personajes únicos, desde vigilantes urbanos
          hasta héroes cósmicos. Con un sistema de reglas completo y flexible, podrás
          vivir aventuras épicas en un universo lleno de organizaciones secretas,
          villanos legendarios y poderes extraordinarios.
        </p>
        <p>
          En el <strong>manual del juego de rol</strong> y los sumplementos se incluyen
          todo lo necesario para tus partidas, catálogo completo de poderes y habilidades,
          información detallada sobre organizaciones y grupos como Los Campeones de
          Europa o los Irregulares, y un extenso archivo de personajes, localizaciones,
          eventos y lore del universo SHI. Ademas en la web encontraras información
          actualizada, personajes de campañas oficiales y diversos recursos útiles
          como el generador de fichas interactivo o la busqueda de FAQs (y erratas).
        </p>
        <p>
          Ya seas un jugador experimentado o estés comenzando en el mundo del
          rol de superhéroes, Superheroes INC. te ofrece las herramientas para
          crear historias memorables y personajes inolvidables. Explora nuestros
          recursos, crea tu héroe y únete a la aventura.
        </p>
      </div>
    </div>
  </section>

  <section class="news-section">
    <h2 class="section-title">Últimas Entradas del Blog</h2>
    <div class="news-grid">
      {news.map((item) => <ComicCard {...item} client:visible />)}
    </div>
    <div class="section-footer">
      <a href="/blog" class="comic-button small">Ver todas las entradas</a>
    </div>
  </section>

  <section class="lore-section">
    <h2 class="section-title">Últimos Archivos del Lore Actualizados</h2>
    <div class="news-grid">
      {latestLore.map((item) => <ComicCard {...item} client:visible />)}
    </div>
    <div class="section-footer">
      <a href="/lore" class="comic-button small">Explorar el Archivo</a>
    </div>
  </section>

  <section class="characters-section">
    <h2 class="section-title">Últimos Personajes Subidos</h2>
    <div class="characters-grid">
      {
        latestCharacters.map((item) => (
          <CharacterCard {...item} client:visible />
        ))
      }
    </div>
    <div class="section-footer">
      <a href="/personajes" class="comic-button small"
        >Ver Galería de Personajes</a
      >
    </div>
  </section>
</Layout>

<style>
  .lore-section,
  .characters-section {
    padding: var(--spacing-2xl) var(--spacing-lg);
    max-width: 1400px;
    margin: 0 auto;
  }

  .hero-container {
    padding: var(--spacing-2xl) var(--spacing-lg);
    max-width: 1400px;
    margin: 0 auto;
  }

  .intro-section {
    padding: var(--spacing-2xl) var(--spacing-lg);
    max-width: 1200px;
    margin: 0 auto;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(255, 255, 255, 0.5),
      transparent
    );
  }

  .intro-content {
    background: white;
    border: 3px solid var(--color-secondary);
    padding: var(--spacing-xl);
    box-shadow: var(--shadow-md);
  }

  .intro-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-secondary);
    margin-bottom: var(--spacing-lg);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: var(--spacing-md);
  }

  .intro-text {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.8;
    color: #1f2937;
  }

  .intro-text p {
    margin-bottom: var(--spacing-md);
  }

  .intro-text p:last-child {
    margin-bottom: 0;
  }

  .intro-text strong {
    color: var(--color-secondary);
    font-weight: 600;
  }

  .news-section {
    padding: var(--spacing-2xl) var(--spacing-lg);
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    text-align: center;
    margin-bottom: var(--spacing-xl);
    color: var(--color-secondary);
    position: relative;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 2px solid var(--color-secondary);
    display: inline-block;
    padding-bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .section-title::before {
    content: "///";
    margin-right: 1rem;
    color: var(--color-primary);
  }

  .section-title::after {
    content: "///";
    margin-left: 1rem;
    color: var(--color-primary);
  }

  .news-grid,
  .characters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--spacing-xl);
    margin-top: var(--spacing-xl);
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: var(--text-4xl);
    }

    .news-grid,
    .characters-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }

  .access-options {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: 2px dashed #d3d0c2;
    position: relative;
  }

  /* Desktop layout */
  @media (min-width: 768px) {
    .access-options {
      flex-direction: row;
      justify-content: center;
      align-items: flex-start;
      gap: var(--spacing-2xl);
    }
  }

  .access-divider-label {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background-color: white;
    padding: 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: #9ca3af;
  }

  .access-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .access-note {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: #6b7280;
  }

  .recruit-button-wrapper {
    position: relative;
    /* Ensure the button is big enough */
    min-width: 220px;
    text-align: center;
  }

  .priority-badge {
    position: absolute;
    top: -12px;
    right: -12px;
    background-color: var(--color-primary);
    color: white;
    font-size: 0.6rem;
    padding: 2px 6px;
    transform: rotate(6deg);
    border: 1px solid var(--color-primary-dark);
    box-shadow: var(--shadow-sm);
  }
  .section-footer {
    display: flex;
    justify-content: center;
    margin-top: var(--spacing-xl);
  }

  .comic-button.small {
    font-size: var(--text-sm);
    padding: 0.5rem 1.5rem;
  }
</style>
