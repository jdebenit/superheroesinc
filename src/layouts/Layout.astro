---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BaseHead, { type Props as BaseHeadProps } from "../components/SEO/BaseHead.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

type Props = BaseHeadProps;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead {...Astro.props} />
	</head>
	<body>
		<div class="stamp-top-secret">TOP SECRET</div>
		<a href="#main-content" class="skip-link"
			>Saltar al contenido principal</a
		>
		<Navbar />
		<Breadcrumbs />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		min-height: 80vh;
		padding: 2rem 0;
	}

	.skip-link {
		position: absolute;
		top: -40px;
		left: 0;
		background: var(--color-primary);
		color: white;
		padding: 8px;
		z-index: 100;
		transition: top 0.3s;
	}

	.skip-link:focus {
		top: 0;
	}
</style>
