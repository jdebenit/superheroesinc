---
import "../styles/global.css";
import BaseHead, { type Props as BaseHeadProps } from "../components/SEO/BaseHead.astro";

type Props = BaseHeadProps;
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead {...Astro.props} />
    </head>
    <body class="fullscreen-body">
        <main class="fullscreen-main">
            <slot />
        </main>
    </body>
</html>

<style>
    .fullscreen-body {
        margin: 0;
        padding: 0;
        overflow: hidden;
    }

    .fullscreen-main {
        width: 100vw;
        height: 100vh;
        margin: 0;
        padding: 0;
        overflow: auto;
    }
</style>
